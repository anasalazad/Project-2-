+package com.thefelineco.ui.navigation
+
+import androidx.compose.runtime.Composable
+import androidx.navigation.NavHostController
+import androidx.navigation.compose.NavHost
+import androidx.navigation.compose.composable
+import com.thefelineco.domain.model.User
+import com.thefelineco.ui.common.ComingSoonScreen
+
+/** Every in-app screen for a signed-in user. Secondary activities are launched from these screens. */
+@Composable
+fun FelineNavHost(
+    navController: NavHostController,
+    user: User,
+    onLogout: () -> Unit,
+) {
+    NavHost(
+        navController = navController,
+        startDestination = if (user.isAdmin) AdminDashboardRoute else HomeRoute,
+    ) {
+        // Customer
+        composable<HomeRoute> { ComingSoonScreen("Home") }
+        composable<AdoptRoute> { ComingSoonScreen("Adopt") }
+        composable<CatDetailRoute> { ComingSoonScreen("Cat profile") }
+        composable<ShopRoute> { ComingSoonScreen("Shop") }
+        composable<BasketRoute> { ComingSoonScreen("Basket") }
+        composable<BookingsRoute> { ComingSoonScreen("My bookings") }
+        composable<ProfileRoute> {
+            ComingSoonScreen(
+                title = "Hi, ${user.firstName}",
+                message = "${user.email} · ${user.credits} credits",
+                actionLabel = "Log out",
+                onAction = onLogout,
+            )
+        }
+
+        // Admin
+        composable<AdminDashboardRoute> { ComingSoonScreen("Admin dashboard") }
+        composable<AdminCatsRoute> { ComingSoonScreen("Manage cats") }
+        composable<AdminCatEditRoute> { ComingSoonScreen("Edit cat") }
+        composable<AdminBookingsRoute> { ComingSoonScreen("Appointments") }
+        composable<AdminProductsRoute> { ComingSoonScreen("Manage products") }
+        composable<AdminProductEditRoute> { ComingSoonScreen("Edit product") }
+    }
+}
