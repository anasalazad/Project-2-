+<?xml version="1.0" encoding="utf-8"?>
+<!-- The Feline Co. mark: a crimson cat head wearing a small silver crown. -->
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="108dp"
+    android:height="108dp"
+    android:viewportWidth="108"
+    android:viewportHeight="108">
+    <!-- Ears -->
+    <path android:fillColor="#C8102E" android:pathData="M35.5,54 L37,29 L51,42 Z" />
+    <path android:fillColor="#C8102E" android:pathData="M72.5,54 L71,29 L57,42 Z" />
+    <!-- Inner ears -->
+    <path android:fillColor="#8E0B20" android:pathData="M39,48 L39.8,34.5 L47.5,42 Z" />
+    <path android:fillColor="#8E0B20" android:pathData="M69,48 L68.2,34.5 L60.5,42 Z" />
+    <!-- Face -->
+    <path android:fillColor="#C8102E" android:pathData="M33,61 a21,19.5 0 1,0 42,0 a21,19.5 0 1,0 -42,0z" />
+    <!-- Crown -->
+    <path android:fillColor="#E6E6EA" android:pathData="M46.5,42 L46.5,32 L50.5,36 L54,28.5 L57.5,36 L61.5,32 L61.5,42 Z" />
+    <!-- Eyes -->
+    <path android:fillColor="#0E0E10" android:pathData="M42.6,59 a3.4,4.4 0 1,0 6.8,0 a3.4,4.4 0 1,0 -6.8,0z" />
+    <path android:fillColor="#0E0E10" android:pathData="M58.6,59 a3.4,4.4 0 1,0 6.8,0 a3.4,4.4 0 1,0 -6.8,0z" />
+    <!-- Nose -->
+    <path android:fillColor="#0E0E10" android:pathData="M51,66 L57,66 L54,69.5 Z" />
+    <!-- Whiskers -->
+    <path android:strokeColor="#E6E6EA" android:strokeWidth="1.4" android:strokeLineCap="round"
+        android:pathData="M36,66 L24,63.5 M36,70 L24.5,71.5 M72,66 L84,63.5 M72,70 L83.5,71.5" />
+</vector>
